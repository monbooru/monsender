{
  "name": "monsender",
  "version": "1.4.1",
  "description": "Send the current page or its images to the download queue of the monloader server you run.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "node build.js",
    "build:chrome": "node build.js chrome",
    "build:firefox": "node build.js firefox",
    "icons": "node tools/gen-icons.js",
    "clean": "rm -rf dist",
    "tooling:webext": "npm ci --prefix tools/webext",
    "lint": "tools/webext/node_modules/.bin/web-ext lint --source-dir dist/firefox --self-hosted",
    "sign": "tools/webext/node_modules/.bin/web-ext sign --source-dir dist/firefox --channel listed --approval-timeout 0",
    "run:firefox": "tools/webext/node_modules/.bin/web-ext run --source-dir dist/firefox"
  },
  "keywords": [
    "browser-extension",
    "manifest-v3",
    "monloader",
    "monbooru",
    "gallery-dl"
  ],
  "author": "leqwin",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/monbooru/monsender"
  },
  "engines": {
    "node": ">=22"
  }
}
